{
  "name": "veloxa-cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config apps/web/vite.config.ts",
    "start": "bun run dev",
    "build": "tsc -b apps/web/tsconfig.json && bun --bun vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -b apps/web/tsconfig.json",
    "lint": "oxlint apps/web/src apps/web/vite.config.ts",
    "preview": "bun --bun vite preview --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
