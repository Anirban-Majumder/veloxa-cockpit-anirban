# OpenAI-compatible endpoint used through the AI SDK.
LLM_BASE_URL=https://your-gateway.example/v1
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Set to false for endpoints without native JSON Schema output (JSON mode + local validation instead).
# LLM_JSON_SCHEMA=true

# Optional overrides
