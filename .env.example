# Required, also for Docker: the first start generates the worry list with the model.
# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional proxy; leave empty for Google's default endpoint
GEMINI_BASE_URL=

# dev (default): no sign-in, no Secure cookies; PUBLIC_BASE_PATH and PUBLIC_ORIGINS are ignored. Use on localhost.
# prod: VELOXA_PASSPHRASE is required, cookies are Secure, and the two settings below take effect.
APP_ENV=dev

# Shared sign-in passphrase. Required when APP_ENV=prod.
VELOXA_PASSPHRASE=

# Path prefix the reverse proxy strips before forwarding, e.g. /VeloxaDigitalHQ (prod only)
PUBLIC_BASE_PATH=
# Comma-separated browser origins allowed to call the API, e.g. https://cockpit.example.com (prod only)
PUBLIC_ORIGINS=

# Optional overrides for bun run dev/start (Docker sets its own HOST and paths)
# VELOXA_RELEASE_DIR=data/Release_Packs
# VELOXA_DB=data/veloxa.db
# PORT=8787
# HOST=127.0.0.1
